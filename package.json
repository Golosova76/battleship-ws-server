{
  "name": "ws_task",
  "version": "1.0.0",
  "description": "Websocket battleship server",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production npm run build && node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development tsx index.ts",
    "start:watch": "cross-env NODE_ENV=development tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "author": "Andrei Auchynnikau",
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
